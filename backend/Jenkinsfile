 pipeline {
  agent any

  environment {
		REGISTRY = "quay.io"
    QUAY_ORG = "papeousmane"          
    IMAGE_NAME = "accel-connect-back" 
    // IMAGE_TAG = "2.${env.BUILD_NUMBER}"
    FULL_IMAGE = "${REGISTRY}/${QUAY_ORG}/${IMAGE_NAME}"
	  
        
	}
  
  stages {
    
    stage('Set environment') {
            steps {
                script {
                    if (env.BRANCH_NAME == 'prod' ) {
                        env.ENV_NAME = 'prod'
                    } 
					else {
                        env.ENV_NAME = 'test'
                    }
                    env.IMAGE_TAG = "v2.${env.BUILD_NUMBER}-${env.ENV_NAME}"
                }
            }
    }
    stage('Build') {
      steps {
        dir('backend') {
          sh 'mvn clean install'
        }
      }
    }

    stage('SonarQube Analysis') {
       steps {
          dir('backend') {
            withSonarQubeEnv('sonarqube') {
            sh "mvn clean verify sonar:sonar -Dsonar.projectKey=accel-connect -Dsonar.projectName='accel_connect' -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml"
          }
        }
      }
    }
    // stage('Quality Gate') {
    //   steps {
    //     timeout(time: 5, unit: 'MINUTES') {
    //       script {
    //         def qg = waitForQualityGate()
    //         if (qg.status != 'OK') {
    //           emailext body: """<h2>Échec du Quality Gate SonarQube</h2>
    //                                 <p><strong>Projet:</strong> ${env.JOB_NAME}</p>
    //                                 <p><strong>Build:</strong> #${env.BUILD_NUMBER}</p>
    //                                 <p><strong>Status:</strong> ${qg.status}</p>
    //                                 <a href="http://192.168.15.115:9000/dashboard?id=accel-connect">voir le rapport Sonar</a>
    //                                 <p>Merci de corriger les problèmes avant de merger.</p>""", 
    //           mimeType: 'text/html', 
    //           recipientProviders: [requestor()], 
    //           subject: "Sonarqube Quality Gate Failed - ${env.JOB_NAME} #${env.BUILD_NUMBER}", 
    //           to: 'aminata.diouck@accel-tech.net, papeousmane.ndiaye@accel-tech.net '
    //           error "Quality Gate failed: ${qg.status}"
              
    //         }
    //       }
    //     }
    //   }
    // }
    stage('Build Image') {
         steps {
          dir('backend') {
            sh " docker build -t $FULL_IMAGE:$IMAGE_TAG . "
      }             
        
    }
}
    stage('Push Image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'paousmane-dockehub-id',
                    usernameVariable: 'QUAY_USER',
                    passwordVariable: 'QUAY_TOKEN'
                )]) {

                    sh """
                        echo "${QUAY_TOKEN}" | docker login ${REGISTRY} \
                            -u "${QUAY_USER}" \
                            --password-stdin

                        docker push ${FULL_IMAGE}:${IMAGE_TAG}
                        docker logout
                    """
                }
            }
        }
    
  }
  post {
	always{
		cleanWs()
	}
  }
  
}
